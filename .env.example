# =============================================================================
# Ticket email notifications (optional)
# =============================================================================
# If set, the ticketing module will email the requester and assignee when
# tickets are created, assigned, or commented. Leave blank to skip sending.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Tickets <noreply@yourdomain.com>"

# =============================================================================
# Optional: Custom Ports (if you want to change from defaults)
# =============================================================================
# WEB_PORT=3050
# DB_PORT=3359
